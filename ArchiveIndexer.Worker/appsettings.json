{
  "ArchiveSettings": {
    "ArchiveRoot": "D:\\MarsArchive", //This is the root folder where all the zip files are stored. Make sure this path exists and the application has read permissions.
    "IndexPath": "C:\\Windows\\System32\\ArchiveIndexer\\Index", //check if this path is correct and have permissions or not
    "CatalogPath": "C:\\Windows\\System32\\ArchiveIndexer\\Catalog\\ZipCatalog.json", //check if this path is correct and have permissions or not

    "EnableWatcher": true,

    "MaxParallelZipScans": 2,

    "CommitIntervalSeconds": 30,

    "SupportedExtensions": [
      ".zip"
    ]
  },

  "LuceneSettings": {
    "CommitAfterDocuments": 5000,
    "CommitAfterSeconds": 30
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Windows\\System32\\ArchiveIndexer\\Logs\\ArchiveIndexer-.log", //check if this path is correct and have permissions or not
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ]
  }
}